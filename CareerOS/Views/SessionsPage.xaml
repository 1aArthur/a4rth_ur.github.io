<Page x:Class="CareerOS.Views.SessionsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Sessões de Estudo" FontSize="28" FontWeight="Bold"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox Width="240" PlaceholderText="Tópico" Text="{Binding Topic, Mode=TwoWay}"/>
            <NumberBox Width="120" Value="{Binding DurationMinutes, Mode=TwoWay}" SpinButtonPlacementMode="Inline"/>
            <Button Content="Registrar" Command="{Binding AddSessionCommand}"/>
        </StackPanel>
        <ListView Grid.Row="2" ItemsSource="{Binding Sessions}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Date}" Width="180"/>
                        <TextBlock Text="{Binding Topic}" Width="250"/>
                        <TextBlock Text="{Binding DurationMinutes}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
