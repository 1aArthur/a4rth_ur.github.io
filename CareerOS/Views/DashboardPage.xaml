<Page
    x:Class="CareerOS.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="16" Padding="20">
            <TextBlock Text="Dashboard" FontSize="30" FontWeight="Bold"/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#252547" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Horas semana"/><TextBlock Text="{Binding WeeklyHours}" FontSize="24"/></StackPanel></Border>
                <Border Grid.Column="1" Background="#252547" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Sessões"/><TextBlock Text="{Binding SessionsCompleted}" FontSize="24"/></StackPanel></Border>
                <Border Grid.Column="2" Background="#252547" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Exercícios"/><TextBlock Text="{Binding SolvedExercises}" FontSize="24"/></StackPanel></Border>
            </Grid>
            <ProgressBar Value="{Binding WeeklyGoalPercent}" Maximum="100" Height="20" />
            <TextBlock Text="Meta semanal concluída" />
        </StackPanel>
    </ScrollViewer>
</Page>
