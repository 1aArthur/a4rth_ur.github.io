<h2>Configurações de Segurança</h2>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-info">@msg</div>
}

<div class="card-pro p-3 mb-3">
    <h5>GitHub padrão da sua conta</h5>
    <form method="post" asp-action="SaveGithub" class="d-flex gap-2">
        <input class="form-control" name="githubUsername" value="@ViewData["GithubUsername"]" placeholder="seu-username-github" />
        <button class="btn btn-primary">Salvar</button>
    </form>
    <small class="text-light">Somente letras, números e hífen.</small>
</div>

<div class="card-pro p-3">
    <p>Tema escuro ativo.</p>
    <p>Headers de segurança, CSRF global, rate limiting e sessão segura habilitados.</p>
</div>
