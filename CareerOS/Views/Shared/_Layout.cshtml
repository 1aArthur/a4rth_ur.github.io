@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="@tokens.RequestToken" />
    <title>Career OS Web</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="theme-dark">
<div class="app-shell d-flex">
    <aside class="sidebar p-3">
        <h4 class="mb-4">Career OS</h4>
        <nav class="nav flex-column gap-2">
            <a asp-controller="Home" asp-action="Index">Dashboard</a>
            <a asp-controller="Studies" asp-action="Index">Estudos</a>
            <a asp-controller="Sessions" asp-action="Index">Sessões</a>
            <a asp-controller="Sessions" asp-action="Index" asp-fragment="pomodoro">Pomodoro</a>
            <a asp-controller="Practice" asp-action="Index">Prática</a>
            <a asp-controller="Goals" asp-action="Index">Metas</a>
            <a asp-controller="GitHub" asp-action="Index">GitHub</a>
            <a asp-controller="ProfessionalSummary" asp-action="Index">Resumo Profissional</a>
            <a asp-controller="Settings" asp-action="Index">Configurações</a>
        </nav>
    </aside>
    <main class="content p-4 w-100">
        @RenderBody()
    </main>
</div>
<script src="~/js/pomodoro.js"></script>
</body>
</html>
