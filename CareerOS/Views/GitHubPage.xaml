<Page x:Class="CareerOS.Views.GitHubPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Integração GitHub" FontSize="28" FontWeight="Bold"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox Width="220" PlaceholderText="Username" Text="{Binding Username, Mode=TwoWay}"/>
            <Button Content="Buscar" Command="{Binding FetchCommand}"/>
        </StackPanel>
        <ListView Grid.Row="2" ItemsSource="{Binding Repos}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1E1E38" CornerRadius="10" Margin="0,4" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" TextWrapping="WrapWholeWords" Opacity="0.85"/>
                            <TextBlock Text="{Binding Language}" Foreground="#7FD7FF"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
