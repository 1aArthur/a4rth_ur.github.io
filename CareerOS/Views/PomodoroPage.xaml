<Page x:Class="CareerOS.Views.PomodoroPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="20" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Pomodoro" FontSize="30" FontWeight="Bold"/>
        <TextBlock Text="{Binding Remaining}" FontSize="68" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <NumberBox Width="120" Value="{Binding FocusMinutes, Mode=TwoWay}"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Content="Iniciar" Command="{Binding StartCommand}"/>
            <Button Content="Pausar" Command="{Binding PauseCommand}"/>
            <Button Content="Reiniciar" Command="{Binding ResetCommand}"/>
        </StackPanel>
    </StackPanel>
</Page>
