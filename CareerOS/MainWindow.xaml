<Window
    x:Class="CareerOS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Career OS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="AppNavigationView"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="True"
                        SelectionChanged="AppNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home" />
                <NavigationViewItem Content="Estudos" Tag="Studies" Icon="Library" />
                <NavigationViewItem Content="Sessões" Tag="Sessions" Icon="Clock" />
                <NavigationViewItem Content="Pomodoro" Tag="Pomodoro" Icon="Play" />
                <NavigationViewItem Content="Prática" Tag="Practice" Icon="Edit" />
                <NavigationViewItem Content="Metas" Tag="Goals" Icon="Target" />
                <NavigationViewItem Content="GitHub" Tag="GitHub" Icon="World" />
                <NavigationViewItem Content="Resumo Profissional" Tag="ProfessionalSummary" Icon="Document" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <Border Grid.Row="1" Background="#1A1A2E" Padding="10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#BFC7FF" />
        </Border>
    </Grid>
</Window>
